{
  "name": "scene-agentcore-demo",
  "version": "1.9.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1127.0",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/client-lambda": "3.1127.0",
    "@aws-sdk/client-neptunedata": "3.1127.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/client-s3vectors": "3.1127.0",
    "@aws-sdk/client-sqs": "3.1175.0",
    "@aws-sdk/credential-provider-ini": "3.973.31",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@smithy/signature-v4": "5.7.3",
    "aws-jwt-verify": "5.2.1",
    "constructs": "10.8.1",
    "graphology": "0.26.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "2.272.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  },
  "scripts": {
    "build": "node scripts/build-scene-demo.mjs",
    "synth": "npm run build && cdk synth --quiet",
    "deploy": "npm run build && node -e \"require('node:fs').mkdirSync('outputs', { recursive: true })\" && cdk deploy --outputs-file outputs/scene-demo-stack.json",
    "demo:character": "node --env-file-if-exists=.env.local --import tsx examples/agentcore-character-demo/server.ts",
    "test": "tsx --test tests/narrative-graph.test.ts tests/scene-streaming.test.ts tests/scene-world.test.ts tests/scene-continuation.test.ts tests/scene-creator.test.ts tests/scene-partner.test.ts tests/scene-gpu.test.ts tests/scene-author-jobs.test.ts tests/scene-creator-tools.test.ts"
  }
}
